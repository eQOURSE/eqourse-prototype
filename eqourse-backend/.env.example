# Existing backend settings (MongoDB, JWT, email, etc.) remain required.

# Public origin used for blog and case-study canonical URLs.
PUBLIC_SITE_URL=https://www.eqourse.com

# Absolute path Nginx actually serves. This is NOT the project build directory.
# The backend writes each published article's server-readable HTML here on every
# create, edit, publish, unpublish and startup reconciliation.
FRONTEND_DIST_DIR=/opt/eqourse-prototype/dist

# Existing Utho disk origin served by cdn.eqourse.com through Google Cloud CDN.
EVENT_MEDIA_DISK_ROOT=/var/www/eqourse-cdn
EVENT_CDN_BASE_URL=https://cdn.eqourse.com

# Fail production startup if published CMS pages cannot be synchronized.
CMS_SEO_SYNC_REQUIRED=true

# Gemini models used by the public chatbot and admin applicant smart filter.
# Both default to the latest verified stable model when these are omitted.
GEMINI_CHAT_MODEL=gemini-3.7-flash
GEMINI_ADMIN_MODEL=gemini-3.7-flash

GOOGLE_SHEET_ID=your_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account-email
GOOGLE_PRIVATE_KEY="your_private_key"

GOOGLE_SHEET_TAB_1=Pilot Queries
GOOGLE_SHEET_TAB_2=Contact Queries

# New MongoDB inserts are synced serially to avoid Google Sheets write quotas.
GOOGLE_SHEET_SYNC_DELAY_MS=1500
# Set to true only when an explicit existing-leads backfill is required.
GOOGLE_SHEET_BACKFILL_ON_STARTUP=false
# Optional; direct post-insert sync is the default and works without replica sets.
GOOGLE_SHEET_CHANGE_STREAM_ENABLED=false
