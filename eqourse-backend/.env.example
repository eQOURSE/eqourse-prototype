# Existing backend settings (MongoDB, JWT, email, etc.) remain required.

# Public origin used for blog and case-study canonical URLs.
PUBLIC_SITE_URL=https://www.eqourse.com

# Absolute path Nginx actually serves. This is NOT the project build directory.
# The backend writes each published article's server-readable HTML here on every
# create, edit, publish, unpublish and startup reconciliation.
# FRONTEND_DIST_DIR=/var/www/eqourse/dist

# Fail production startup if published CMS pages cannot be synchronized.
CMS_SEO_SYNC_REQUIRED=true

# Gemini models used by the public chatbot and admin applicant smart filter.
# Both default to the latest verified stable model when these are omitted.
GEMINI_CHAT_MODEL=gemini-3.7-flash
GEMINI_ADMIN_MODEL=gemini-3.7-flash

# ─── Cloudflare R2 object storage for public sample media ────────────────────
# Sample files and thumbnails uploaded from the admin panel are stored in R2 and
# served from the bucket's Custom Domain, so sample traffic never touches this
# origin. Setup runbook: docs/SAMPLES_CDN.md
#
# Leave these blank to keep uploads on local disk. The backend checks for all
# five values and silently falls back to `uploads/<kind>/` when any is missing,
# which is what makes development and a pre-credential deploy work unchanged.
#
# ONLY the `sample-file` and `sample-thumbnail` upload kinds are written to R2.
# The bucket is world-readable, and POST /api/free-pilot shares the upload
# middleware while being public and unauthenticated, so pilot attachments,
# candidate resumes and vendor documents deliberately stay on local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eqourse

# Custom Domain attached to the bucket. Must NOT be the r2.dev URL: that is
# rate-limited, meant for testing, and is not served through the CDN cache.
R2_PUBLIC_BASE_URL=https://cdn.eqourse.com
