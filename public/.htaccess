# Generated from src/routes/legacyRedirects.ts. Do not edit by hand.
Options -MultiViews
DirectoryIndex index.html
DirectorySlash Off
RewriteEngine On

# Legacy URLs redirect directly to the final HTTPS + www canonical URL.
